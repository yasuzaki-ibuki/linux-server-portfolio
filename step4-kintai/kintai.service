[Unit]
Description=Kintai - attendance and daily report app
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=yasu
Group=yasu
WorkingDirectory=/opt/kintai
Environment=SCRIPT_NAME=/kintai
ExecStart=/opt/kintai/venv/bin/gunicorn -b 127.0.0.1:8003 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
